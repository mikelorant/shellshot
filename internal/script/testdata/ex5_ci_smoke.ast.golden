Script
  Settings
    size "80x24" at=0 @3:1
    shell argv=["/bin/sh"] at=0 raw="/bin/sh" @4:1
    cwd "/tmp/ci-work" at=0 @5:1
    env "PS1=$ " at=0 @6:1
    env "TERM=xterm-256color" at=0 @7:1
    env "NO_COLOR=1" at=0 @8:1
    env "LANG=C.UTF-8" at=0 @9:1
    seed "42" at=0 @10:1
    jitter "25%" at=0 @11:1
    typing "35ms" at=0 @12:1
    timeout "20s" at=0 @13:1
    settle "300ms" at=0 @14:1
    output "smoke.shot" at=0 @15:1
  Items
    Block scene "version" @17:1-20:1
      Items
        Step run raw "./bin/app --version" @18:3
        Step wait regex "^app v[0-9]+\\.[0-9]+\\.[0-9]+$" @19:3
    Block scene "help" @22:1-26:1
      Items
        Step run raw "./bin/app --help | head -n 5" @23:3
        Step wait string "Usage:" 0s @24:3
        Step mark "help-shown" @25:3
    Block scene "interrupt" @28:1-34:1
      Items
        Step run raw "sleep 30" @29:3
        Step sleep 500ms @30:3
        Step press ctrl+c*1 @31:3
        Step wait regex "^\\$$" 5s @32:3
        Step press up*1 up*1 enter*1 @33:3
