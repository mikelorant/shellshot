Script
  Settings
    size "110x30" at=0 @1:1
    shell argv=["/bin/sh"] at=0 raw="/bin/sh" @2:1
    env "CI=1" at=0 @3:1
    env "PS1=$ " at=0 @4:1
    timeout "120s" at=0 @5:1
    typing "30ms" at=0 @6:1
    hold "1s" at=0 @7:1
  Items
    Block hidden "" @9:1-15:1
      Items
        Step run lines "cd ~/src/app\nmake clean > /dev/null 2>&1\nclear\n" @10:3
    Block scene "build" @17:1-24:1
      Settings
        speed "8x" at=0 @18:3
        idle "2s" at=0 @19:3
        settle "off" at=0 @20:3
      Items
        Step run raw "make build; echo BUILD-STATUS=$?" @21:3
        Step wait regex "^BUILD-STATUS=0$" 5m @22:3
        Step mark "built" @23:3
    Block scene "check" @26:1-30:1
      Settings
        linger "2s" at=0 @27:3
      Items
        Step run raw "./bin/app --version" @28:3
        Step wait regex "v[0-9]+\\.[0-9]+" @29:3
