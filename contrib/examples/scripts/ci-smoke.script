# A deterministic smoke test: runs two demos and asserts what is on screen.
# Run from the repository root:
#   shellshot record --script contrib/examples/scripts/ci-smoke.script
size 80x24
shell /bin/sh
env PS1="$ "
env EXAMPLES_SPEED=fast
env NO_COLOR=
seed 42
typing 10ms
timeout 30s
output ci-smoke.shot

scene build {
  run sh contrib/examples/buildlog.sh
  wait "BUILD OK" 0s              # run has settled, so the text must be on screen now
  wait /BUILD OK in [0-9.]+s/ 0s
  mark build-ok
}

scene colours {
  run sh contrib/examples/colors.sh
  wait "truecolour" 0s
  wait "16 colours" 0s
}

scene refuse {
  run sh contrib/examples/colors.sh | cat
  wait "stdout is not a terminal" 0s
}
