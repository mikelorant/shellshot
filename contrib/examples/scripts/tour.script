# Plays contrib/examples/showcase.sh as three scenes and leaves it with Enter (--pause).
# Run from the repository root:
#   shellshot record --script contrib/examples/scripts/tour.script
size 80x24
shell /bin/sh
env PS1="$ "
env EXAMPLES_SPEED=normal
timeout 60s
settle off
linger 500ms
output tour.shot

scene start {
  run ./contrib/examples/showcase.sh --pause
  wait "shellshot" 10s
}

scene watch {
  speed 1x
  sleep 20s
  wait "That was shellshot" 30s
}

scene quit {
  hold 2s
  press enter
  wait idle 500ms
  mark tour-done
}
